#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 [ernolf] Raphael Gradenwitz
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

# Read an uncommented "key = value" from a dnsmasq config file, trimmed
conf_value() {
    awk -v k="$1" '$0 ~ "^[[:space:]]*" k "[[:space:]]*=" {
        sub(/^[^=]*=[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print; exit }' "$2"
}

# == Config ==
# Only these paths are dcm's own; everything else is read from dnsmasq itself.
NODES_FILE="/etc/dcm/nodes"
DEFAULT_FILE="/etc/default/dnsmasq"
BUILD_CACHE="/var/lib/dcm/cluster-build"

# Derive all dnsmasq paths from dnsmasq's own config (single source of truth).
# dnsmasq merges the conf-file with every snippet in the conf-dir, so dcm reads
# the same set: the conf-file (if still a real file) plus all *.conf snippets,
# with snippets taking precedence (/dev/null is not -f, so it drops out).
# shellcheck source=/dev/null
. "${DEFAULT_FILE}"
_tmp="${DNSMASQ_OPTS#*--conf-file=}"
DNSMASQ_CONF="${_tmp%%[ \"]*}"
unset _tmp
DNSMASQ_D="${CONFIG_DIR%%,*}"                              # CONFIG_DIR, minus ,.dpkg-* suffixes

# Last uncommented "key = value" across all given files wins.
conf_value_multi() {
    local key="$1"; shift
    local f v out=""
    for f in "$@"; do
        [[ -f "${f}" ]] || continue
        v="$(conf_value "${key}" "${f}")"
        [[ -n "${v}" ]] && out="${v}"
    done
    printf '%s\n' "${out}"
}

_sources=()
[[ -f "${DNSMASQ_CONF}" ]] && _sources+=("${DNSMASQ_CONF}")
for _f in "${DNSMASQ_D}"/*.conf; do [[ -f "${_f}" ]] && _sources+=("${_f}"); done
HOSTS_DIR="$(conf_value_multi addn-hosts   "${_sources[@]}")"   # addn-hosts =
LOG_FILE="$(conf_value_multi log-facility "${_sources[@]}")"    # log-facility =
HOSTS_DIR="${HOSTS_DIR:-${DNSMASQ_D}/hosts}"
LOG_FILE="${LOG_FILE:-/var/log/dnsmasq/dnsmasq.log}"
unset _f _sources

SELF=$(hostname -s)
DNSMASQ_BIN=$(command -v dnsmasq || echo /usr/sbin/dnsmasq)

# ----------------------------------------

# The running build of this node, as "version=" / "features=" / "options="
# lines. All three matter to the cluster, because dnsmasq aborts at startup on
# a directive its build does not know — a config written for a newer or richer
# build takes the other node down on its next restart. The option list comes
# from the binary itself (--help), so dcm needs no table of what exists in
# which release. LC_ALL=C because both outputs are translated otherwise.
build_local() {
    LC_ALL=C "${DNSMASQ_BIN}" --version 2>/dev/null | awk '
        tolower($0) ~ /^dnsmasq version/ { print "version=" $3 }
        /^Compile time options:/ { sub(/^[^:]*:[[:space:]]*/, ""); print "features=" $0 }'
    echo "options=$(build_options)"
}

# Every long option this build accepts, taken from its own --help. Note that
# --help still lists options whose compile-time feature is missing, so the
# feature list above stays the second half of the answer.
build_options() {
    LC_ALL=C "${DNSMASQ_BIN}" --help 2>/dev/null | awk '
        /^(-[^,]*, )?[[:space:]]*--[a-zA-Z0-9-]+/ {
            match($0, /--[a-zA-Z0-9-]+/)
            print substr($0, RSTART + 2, RLENGTH - 2)
        }' | sort -u | paste -sd' ' -
}

read_nodes() {
    grep -v '^\s*#' "${NODES_FILE}" | grep -v '^\s*$'
}

remote_nodes() {
    read_nodes | grep -v "^${SELF}$"
}

get_node_ip() {
    local node="$1"
    local ip
    ip=$(grep -v '^\s*#' "${HOSTS_DIR}/local" \
        | awk -v h="${node}" '{ for(i=2;i<=NF;i++) if($i==h){ print $1; exit } }')
    if [[ -z "${ip}" ]]; then
        echo "Error: '${node}' not found in ${HOSTS_DIR}/local" >&2
        return 1
    fi
    echo "${ip}"
}

validate_nodes() {
    if [[ ! -d "${HOSTS_DIR}" ]]; then
        cat >&2 <<EOF
Error: 'addn-hosts' resolves to '${HOSTS_DIR}', which is not a directory.
dcm keeps its host files (local, vms, isolated) in a directory, not a single file.
Point 'addn-hosts' at a directory in a snippet under ${DNSMASQ_D}, e.g.:  addn-hosts = ${DNSMASQ_D}/hosts
EOF
        return 1
    fi
    local ok=1
    while IFS= read -r node; do
        if ! get_node_ip "${node}" > /dev/null 2>&1; then
            echo "Error: node '${node}' has no entry in ${HOSTS_DIR}/local" >&2
            ok=0
        fi
    done < <(read_nodes)
    [[ "${ok}" -eq 1 ]]
}

# ----------------------------------------

usage() {
    cat >&2 <<EOF
dcm · dnsmasq cluster manager commandline interface

Usage: $(basename "$0") <command>

  sync                     Sync config files to all remote nodes (no restart)
  restart local|remote|all Restart dnsmasq on node(s)
  status  local|remote     Show dnsmasq status
  logs    [N]              Print last N lines of log (default: 200)
  tail-f  local|remote     Stream log in real time (tail -F)
  stats   local|remote [all|today|1h|24h|7d]
                           Output log analytics as key=value / TSV
  health                   Report live sync/restart/build state as key=value (web UI)
  diff                     List what a sync would change on each remote node
  node-report              Print this node's restart state and build (used by health)
EOF
}

ensure_listen_conf() {
    local node="$1"
    local ip
    ip=$(get_node_ip "${node}")
    if [[ "${node}" == "${SELF}" ]]; then
        printf 'listen-address = 127.0.0.1\nlisten-address = %s\n' "${ip}" \
            > "${DNSMASQ_D}/listen.conf"
    else
        ssh "root@${node}" \
            "printf 'listen-address = 127.0.0.1\nlisten-address = %s\n' '${ip}' \
             > ${DNSMASQ_D}/listen.conf"
    fi
    echo "  listen.conf: 127.0.0.1 + ${ip}"
}

cmd_sync() {
    validate_nodes

    echo "--- Ensuring local listen.conf (${SELF}) ---"
    ensure_listen_conf "${SELF}"

    while IFS= read -r node; do
        echo "--- Syncing to ${node} ---"

        rsync -a "${DEFAULT_FILE}" "root@${node}:${DEFAULT_FILE}"
        echo "  ${DEFAULT_FILE}"

        rsync -a --delete --exclude='listen.conf' "${DNSMASQ_D}/" "root@${node}:${DNSMASQ_D}/"
        echo "  ${DNSMASQ_D}/ (listen.conf excluded)"

        ssh "root@${node}" "mkdir -p $(dirname "${NODES_FILE}")"
        rsync -a "${NODES_FILE}" "root@${node}:${NODES_FILE}"
        echo "  ${NODES_FILE}"

        rsync -a /usr/local/sbin/dcm-cli "root@${node}:/usr/local/sbin/dcm-cli"
        echo "  /usr/local/sbin/dcm-cli"

        ensure_listen_conf "${node}"

    done < <(remote_nodes)

    echo "Sync complete."
}

cmd_restart_local() {
    echo "Restarting dnsmasq on ${SELF} ..."
    systemctl restart dnsmasq
    echo "Done."
}

cmd_restart_remote() {
    while IFS= read -r node; do
        echo "Restarting dnsmasq on ${node} ..."
        ssh "root@${node}" systemctl restart dnsmasq
        echo "Done."
    done < <(remote_nodes)
}

cmd_status_local() {
    echo "=== ${SELF} ==="
    systemctl status dnsmasq --no-pager || true
}

cmd_status_remote() {
    while IFS= read -r node; do
        echo "=== ${node} ==="
        ssh "root@${node}" systemctl status dnsmasq --no-pager || true
    done < <(remote_nodes)
}

cmd_logs() {
    local n="${1:-200}"
    tail -n "${n}" "${LOG_FILE}"
}

cmd_tail_f() {
    local node="${1:-local}"
    if [[ "${node}" == "remote" ]]; then
        local rnode
        rnode=$(remote_nodes | head -1)
        exec ssh -o ServerAliveInterval=15 "root@${rnode}" "tail -F '${LOG_FILE}' 2>/dev/null"
    fi
    exec tail -F "${LOG_FILE}"
}

# Single-pass awk analytics. Output format:
#   scalar:  key=value
#   tabular: TYPE<TAB>key<TAB>count
cmd_stats() {
    local node="${1:-local}"
    local period="${2:-all}"

    if [[ "${node}" == "remote" ]]; then
        local rnode
        rnode=$(remote_nodes | head -1)
        ssh "root@${rnode}" "/usr/local/sbin/dcm-cli stats local ${period}"
        return
    fi

    # Build list of source files (include .1 for 24h/7d/all)
    local files="${LOG_FILE}"
    [[ -f "${LOG_FILE}.1" ]] && files="${LOG_FILE} ${LOG_FILE}.1"

    # Build grep filter for time period
    local grep_args=()
    case "${period}" in
        today)
            grep_args=(-e "^$(LC_ALL=C date '+%b %e')")
            ;;
        1h)
            grep_args=(-e "^$(LC_ALL=C date '+%b %e %H')")
            # Include previous hour too (handles hour boundary)
            grep_args+=(-e "^$(date -d '1 hour ago' '+%b %e %H')")
            ;;
        24h)
            grep_args=(-e "^$(LC_ALL=C date '+%b %e')" -e "^$(LC_ALL=C date -d 'yesterday' '+%b %e')")
            ;;
        7d)
            for i in 0 1 2 3 4 5 6; do
                grep_args+=(-e "^$(LC_ALL=C date -d "${i} days ago" '+%b %e')")
            done
            ;;
    esac

    if [[ "${#grep_args[@]}" -gt 0 ]]; then
        # shellcheck disable=SC2086
        grep -h "${grep_args[@]}" ${files} 2>/dev/null
    else
        # shellcheck disable=SC2086
        cat ${files} 2>/dev/null
    fi | awk '
{
    event = $5
    hour  = substr($3, 1, 2)
    per_hour[hour]++

    if (event ~ /^query\[/) {
        total_queries++
        qt = event; gsub(/^query\[/, "", qt); gsub(/\].*/, "", qt)
        query_types[qt]++
        if (NF >= 6) domains[$6]++
        if (NF >= 8) clients[$8]++

    } else if (event == "forwarded") {
        forwarded++
        if (NF >= 8) upstreams[$8]++

    } else if (event == "cached") {
        cached++
        r = $NF
        if (r == "NXDOMAIN")    cached_nxdomain++
        else if (r ~ /NODATA/)  cached_nodata++

    } else if (event == "reply") {
        r = $NF
        if      (r == "NXDOMAIN")     nxdomain++
        else if (r == "NODATA-IPv6")  nodata_ipv6++
        else if (r == "NODATA")       nodata++
        else if (r == "SERVFAIL")     servfail++
        else if (r == "REFUSED")      refused++
        else if (r == "<CNAME>")      cname++
        else                           resolved++

    } else if (event == "config") {
        r = $NF
        if (r == "127.0.0.1" || r == "::1") blocked++
        else if (r ~ /NODATA/)               {}
        else                                  local_config++

    } else if (event ~ /^\/etc\/dnsmasq/) {
        r = $NF
        if (r == "127.0.0.1" || r == "::1") blocked++
        else                                  local_hosts++
    }
}
END {
    print "total_queries="  total_queries+0
    print "forwarded="      forwarded+0
    print "cached="         cached+0
    print "cached_nxdomain=" cached_nxdomain+0
    print "cached_nodata="  cached_nodata+0
    print "local_config="   local_config+0
    print "local_hosts="    local_hosts+0
    print "blocked="        blocked+0
    print "nxdomain="       nxdomain+0
    print "nodata="         nodata+0
    print "nodata_ipv6="    nodata_ipv6+0
    print "servfail="       servfail+0
    print "refused="        refused+0
    print "cname="          cname+0
    print "resolved="       resolved+0

    for (qt in query_types) print "qtype\t" qt "\t" query_types[qt]+0
    for (u  in upstreams)   print "upstream\t" u "\t" upstreams[u]+0
    for (d  in domains)     print "domain\t"   d "\t" domains[d]+0
    for (c  in clients)     print "client\t"   c "\t" clients[c]+0
    for (h  in per_hour)    print "hour\t"     h "\t" per_hour[h]+0
}
'
}

# Join arguments with commas (no args -> empty string).
join_csv() { local IFS=,; echo "$*"; }

# Reachability probe for a remote node — fast, never prompts.
node_up() {
    ssh -o ConnectTimeout=4 -o BatchMode=yes "root@$1" true 2>/dev/null
}

# Does the content differ from ${node}? 0 = in sync, 1 = differs. Uses rsync's
# dry-run itemiser with --checksum (so a mere mtime change does not count) and
# ignores pure attribute / directory lines (starting with '.') — only real
# content changes remain.
node_in_sync() {
    local node="$1" f
    if rsync -nic -a --delete --exclude='listen.conf' \
            "${DNSMASQ_D}/" "root@${node}:${DNSMASQ_D}/" 2>/dev/null | grep -qvE '^\.'; then
        return 1
    fi
    for f in "${DEFAULT_FILE}" "${NODES_FILE}" /usr/local/sbin/dcm-cli; do
        if rsync -nic -a "${f}" "root@${node}:${f}" 2>/dev/null | grep -qvE '^\.'; then
            return 1
        fi
    done
    return 0
}

# 0 = a restart is needed (a drop-in or hosts file is newer than dnsmasq's start
# time), 1 = ok. The hosts files count: dnsmasq reads addn-hosts at start only,
# so an edited host name is not live until the restart either.
# listen.conf is excluded: it is regenerated on every sync, so its mtime would
# otherwise raise a permanent false alarm.
restart_needed_local() {
    local newest start
    newest=$( { find "${DNSMASQ_D}" -maxdepth 1 -type f -name '*.conf' ! -name 'listen.conf' -printf '%T@\n'
                find "${HOSTS_DIR}" -maxdepth 1 -type f -printf '%T@\n'; } 2>/dev/null | sort -rn | head -1)
    [[ -z "${newest}" ]] && return 1
    start=$(date -d "$(systemctl show dnsmasq -p ActiveEnterTimestamp --value 2>/dev/null)" \
                 +%s 2>/dev/null || echo 0)
    [[ "${start}" -eq 0 ]] && return 1
    if (( ${newest%.*} > start )); then return 0; else return 1; fi
}

# Everything health needs from a single node, in one round trip:
#   restart=needed|ok   version=<v>   features=<compile options>   options=<long options>
cmd_node_report() {
    if restart_needed_local; then echo "restart=needed"; else echo "restart=ok"; fi
    build_local
}

# Remember each node's build, so the web UI can gate its directive list on what
# every node is able to do without an SSH round trip per page view. Records of
# nodes that were unreachable this time are carried over from the previous
# cache: a node that is down must not silently widen what the UI offers.
# $@ holds one "<node>TAB<version>TAB<features>TAB<options>" record per node.
write_build_cache() {
    local tmp
    mkdir -p "$(dirname "${BUILD_CACHE}")"
    # The replace below is atomic, so a temporary that is still around minutes
    # later belongs to a run that was killed between writing and renaming it.
    # The age guard keeps a concurrent run's file out of reach.
    find "$(dirname "${BUILD_CACHE}")" -maxdepth 1 -name "$(basename "${BUILD_CACHE}").*" -mmin +5 -delete 2>/dev/null || :
    tmp="${BUILD_CACHE}.$$"
    # No cache yet is the normal first run: the group must not end on a failed
    # command, or `set -o pipefail` fails the whole pipeline and `set -e` takes
    # health down before it has printed a single line.
    { printf '%s\n' "$@"; cat "${BUILD_CACHE}" 2>/dev/null || :; } \
        | awk -F'\t' 'NR == FNR { member[$0] = 1; next }
                      NF >= 2 && ($1 in member) && !seen[$1]++' <(read_nodes) - > "${tmp}"
    chmod 644 "${tmp}"
    mv "${tmp}" "${BUILD_CACHE}"
}

# Directive keys currently configured, read from the merged drop-ins — what
# every node's dnsmasq has to understand once this config reaches it.
configured_keys() {
    sed -n 's/^[[:space:]]*\([a-z0-9-]\{1,\}\).*/\1/p' "${DNSMASQ_D}"/*.conf 2>/dev/null | sort -u
}

# Live cluster health for the web UI's notifications. Machine-readable:
#   sync=ok|stale       sync-nodes=<comma-separated remotes that differ>
#   restart=ok|needed   restart-nodes=<comma-separated nodes to restart>
#   build=ok|mixed      build-nodes=<node:version,...>
#   build-newest=<highest version in the cluster>
#   build-features=ok|mixed
#   build-unknown=<node:directive,...>  configured but unknown to that node's
#                                       dnsmasq, which would then refuse to start
# Unreachable nodes are skipped — the Dashboard's status dot covers liveness.
cmd_health() {
    local node report version features options key conf_keys
    local sync_stale=() restart_nodes=() records=() versions=() featsets=() unknown=()

    conf_keys=$(configured_keys)

    while IFS= read -r node; do
        if [[ "${node}" == "${SELF}" ]]; then
            report=$(cmd_node_report)
        else
            node_up "${node}" || continue
            node_in_sync "${node}" || sync_stale+=("${node}")
            report=$(ssh -o ConnectTimeout=4 -o BatchMode=yes "root@${node}" \
                         /usr/local/sbin/dcm-cli node-report 2>/dev/null) || continue
        fi
        version=$(sed -n 's/^version=//p' <<< "${report}")
        features=$(sed -n 's/^features=//p' <<< "${report}")
        options=$(sed -n 's/^options=//p' <<< "${report}")
        if grep -q '^restart=needed$' <<< "${report}"; then restart_nodes+=("${node}"); fi
        records+=("$(printf '%s\t%s\t%s\t%s' "${node}" "${version}" "${features}" "${options}")")
        versions+=("${node}:${version}")
        featsets+=("${features}")
        # An option this node's build does not know aborts its dnsmasq at
        # startup, so it fails on the next restart after a sync, not while the
        # setting is being saved.
        [[ -z "${options}" ]] && continue
        while IFS= read -r key; do
            unknown+=("${node}:${key}")
        done < <(awk -v opts="${options}" 'BEGIN { split(opts, a, " "); for (i in a) known[a[i]] = 1 }
                                           NF && !($0 in known)' <<< "${conf_keys}")
    done < <(read_nodes)

    write_build_cache "${records[@]}"

    echo "sync=$([[ ${#sync_stale[@]} -gt 0 ]] && echo stale || echo ok)"
    echo "sync-nodes=$(join_csv "${sync_stale[@]}")"
    echo "restart=$([[ ${#restart_nodes[@]} -gt 0 ]] && echo needed || echo ok)"
    echo "restart-nodes=$(join_csv "${restart_nodes[@]}")"
    echo "build=$([[ $(printf '%s\n' "${versions[@]#*:}" | sort -u | wc -l) -gt 1 ]] && echo mixed || echo ok)"
    echo "build-nodes=$(join_csv "${versions[@]}")"
    echo "build-newest=$(printf '%s\n' "${versions[@]#*:}" | sort -V | tail -1)"
    echo "build-features=$([[ $(printf '%s\n' "${featsets[@]}" | sort -u | wc -l) -gt 1 ]] && echo mixed || echo ok)"
    echo "build-unknown=$(join_csv "${unknown[@]}")"
}

# Human-readable list of what a sync would change on each remote node — the
# detail behind health's sync=stale. Prints changed paths, not rsync's codes.
cmd_diff() {
    local node f any line
    while IFS= read -r node; do
        echo "=== ${node} ==="
        if ! node_up "${node}"; then
            echo "  unreachable"; echo; continue
        fi
        any=0
        while IFS= read -r line; do
            [[ -n "${line}" ]] || continue
            echo "  ${DNSMASQ_D}/${line}"; any=1
        done < <(rsync -nic -a --delete --exclude='listen.conf' \
                     "${DNSMASQ_D}/" "root@${node}:${DNSMASQ_D}/" 2>/dev/null \
                  | grep -vE '^\.' | awk '{print $NF}')
        for f in "${DEFAULT_FILE}" "${NODES_FILE}" /usr/local/sbin/dcm-cli; do
            rsync -nic -a "${f}" "root@${node}:${f}" 2>/dev/null | grep -qvE '^\.' && { echo "  ${f}"; any=1; }
        done
        [[ "${any}" -eq 0 ]] && echo "  in sync"
        echo
    done < <(remote_nodes)
}

# ----------------------------------------

case "${1:-}" in
    sync)
        cmd_sync
        ;;
    restart)
        case "${2:-}" in
            local)   cmd_restart_local ;;
            remote)  cmd_restart_remote ;;
            all)     cmd_restart_local; cmd_restart_remote ;;
            *)       echo "Error: restart requires local, remote, or all" >&2; usage; exit 1 ;;
        esac
        ;;
    status)
        case "${2:-}" in
            local)   cmd_status_local ;;
            remote)  cmd_status_remote ;;
            *)       echo "Error: status requires local or remote" >&2; usage; exit 1 ;;
        esac
        ;;
    logs)
        cmd_logs "${2:-200}"
        ;;
    tail-f)
        cmd_tail_f "${2:-local}"
        ;;
    stats)
        cmd_stats "${2:-local}" "${3:-all}"
        ;;
    health)
        cmd_health
        ;;
    diff)
        cmd_diff
        ;;
    node-report)
        cmd_node_report
        ;;
    *)
        usage; exit 1
        ;;
esac
